// PostgreSQL ทั้ง dev และ production เพื่อให้พฤติกรรมตรงกัน
// dev รันด้วย docker (ดู docs/SETUP.md) — production ใช้ Neon/Supabase/Vercel Postgres
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // ใช้ผ่าน connection pooler — serverless เปิด connection เยอะ ถ้าต่อตรงจะเต็ม limit
  url       = env("DATABASE_URL")
  // ต่อตรงไม่ผ่าน pooler สำหรับ migrate/introspect (pooler ไม่รองรับ)
  // ถ้า provider ไม่มี pooler แยก ใส่ค่าเดียวกับ DATABASE_URL ได้
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js ----------
model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                String    @default("USER")
  tradingViewUsername String?
  lineUserId          String?
  stripeCustomerId    String?   @unique
  createdAt           DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  accessGrants  AccessGrant[]
  payments      Payment[]
  telegramGrants TelegramGrant[]
  slipOrders    SlipOrder[]
  reviews       Review[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Business ----------
model Plan {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  priceTHB      Int
  interval      String
  stripePriceId String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id])
  planCode             String
  stripeSubscriptionId String?   @unique
  stripeCustomerId     String?
  status               String    @default("INACTIVE")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accessGrants AccessGrant[]
}

model AccessGrant {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
  status              String        @default("PENDING")
  tradingViewUsername String?
  note                String?
  grantedAt           DateTime?
  revokedAt           DateTime?
  createdAt           DateTime      @default(now())
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountTHB   Int
  provider    String   @default("stripe")
  providerRef String?
  status      String
  createdAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  rating     Int
  comment    String
  plan       String?
  isApproved Boolean  @default(false)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Signal {
  id        String   @id @default(cuid())
  timeframe String
  side      String?
  symbol    String?
  entry     String?
  tp        String?
  sl        String?
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TelegramGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING") // PENDING | ADDED | REMOVED
  note      String?
  addedAt   DateTime?
  removedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
}

model SlipOrder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode   String
  amountTHB  Int
  status     String    @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  slipData   String?   // base64 data URL ของสลิป
  note       String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("landing")
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([createdAt])
}
