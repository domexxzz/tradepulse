// PostgreSQL ทั้ง dev และ production เพื่อให้พฤติกรรมตรงกัน
// dev รันด้วย docker (ดู docs/SETUP.md) — production ใช้ Neon/Supabase/Vercel Postgres
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // ใช้ผ่าน connection pooler — serverless เปิด connection เยอะ ถ้าต่อตรงจะเต็ม limit
  url       = env("DATABASE_URL")
  // ต่อตรงไม่ผ่าน pooler สำหรับ migrate/introspect (pooler ไม่รองรับ)
  // ถ้า provider ไม่มี pooler แยก ใส่ค่าเดียวกับ DATABASE_URL ได้
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js ----------
model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  /** ชื่อผู้ใช้สำหรับล็อกอินแทนอีเมล — เก็บเป็นตัวพิมพ์เล็กเสมอเพื่อให้ค้นเจอ
      ไม่ว่าผู้ใช้จะพิมพ์มาแบบไหน (unique ของ Postgres แยกตัวพิมพ์ใหญ่เล็ก) */
  username            String?   @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                String    @default("USER")
  tradingViewUsername String?
  /** ราคารายเดือนที่ล็อกไว้ให้สมาชิกโปรโมชัน 300 คนแรก
      ใช้ได้ตราบที่ยังไม่ขาดอายุ — เงื่อนไขจริงอยู่ที่ isPriceLockValid() ใน lib/pricing.ts
      ไม่ลบค่านี้ทิ้งตอนขาดอายุ เพื่อให้ยังตรวจย้อนได้ว่าใครเคยได้ราคาล็อก */
  lockedMonthlyTHB Int?
  discordUserId   String?  @unique
  discordUsername String?
  // รู้ได้ตอนสมาชิกกดเข้ากลุ่มผ่านลิงก์ส่วนตัว — ใช้ตอนนำออกเมื่อหมดอายุ
  telegramUserId   String?  @unique
  telegramUsername String?
  lineUserId          String?
  stripeCustomerId    String?   @unique
  createdAt           DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  accessGrants  AccessGrant[]
  payments      Payment[]
  telegramGrants TelegramGrant[]
  slipOrders    SlipOrder[]
  reviews       Review[]
  passwordResets PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Business ----------
model Plan {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  priceTHB      Int
  interval      String
  stripePriceId String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * ⚠️ planId / plan relation ไม่มีโค้ดไหน join ผ่านเลยสักที่ (ตรวจแล้ว 2026-08-29)
   * ตัวที่ใช้งานจริงคือ planCode ซึ่งเทียบกับ src/config/plans.ts ไม่ใช่ตาราง Plan
   * ตาราง Plan เหลือหน้าที่เดียวคือผูก Stripe Price ID และให้หน้าแอดมินเตือน
   * เวลาราคาใน DB กับใน config ไม่ตรงกัน — อย่าเพิ่งลบทิ้งจนกว่าจะเลิกใช้ Stripe
   */
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id])
  planCode             String
  stripeSubscriptionId String?   @unique
  stripeCustomerId     String?
  status               String    @default("INACTIVE")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  // เวลาที่ cron ปิดสิทธิ์จริง (ไม่ใช่แค่วันครบกำหนด) ใช้ตรวจย้อนหลังว่าปิดไปแล้วจริง
  expiredAt            DateTime?
  // กันส่งอีเมลเตือนใกล้หมดอายุซ้ำในรอบเดียวกัน — เคลียร์เป็น null ทุกครั้งที่ต่ออายุ
  expiryNotifiedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accessGrants AccessGrant[]

  // cron รายวันกวาดด้วยสองคอลัมน์นี้เป็นหลัก
  @@index([status, currentPeriodEnd])
  @@index([userId])
}

model AccessGrant {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
  status              String        @default("PENDING")
  tradingViewUsername String?
  note                String?
  grantedAt           DateTime?
  revokedAt           DateTime?
  createdAt           DateTime      @default(now())

  // คิวแอดมินและ callback ของ TradingView กรองด้วยสองคอลัมน์นี้เป็นหลัก
  @@index([status])
  @@index([userId])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountTHB   Int
  provider    String   @default("stripe")
  /**
   * เลขอ้างอิงจากช่องทางที่ได้เงิน — unique เพื่อกันบันทึกเงินก้อนเดียวซ้ำ
   * เดิมกันซ้ำด้วยการ findFirst แล้วค่อย create ซึ่ง race ได้เต็ม ๆ
   * (webhook ของ Stripe ยิงซ้ำเป็นเรื่องปกติเวลา timeout)
   * NULL ซ้ำกันได้ตามพฤติกรรม unique index ของ Postgres ซึ่งถูกต้องแล้ว
   */
  providerRef String?  @unique
  status      String
  createdAt   DateTime @default(now())

  // countPaidMembers() ยิงทุกครั้งที่เรนเดอร์หน้าแรก และกรองด้วย status
  @@index([status])
  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  rating     Int
  comment    String
  plan       String?
  isApproved Boolean  @default(false)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Signal {
  id        String   @id @default(cuid())
  timeframe String
  side      String?
  symbol    String?
  entry     String?
  tp        String?
  /** อินดิเคเตอร์ส่ง TP มาสองชั้น (TP1/TP2) — tp คือ TP1 */
  tp2       String?
  sl        String?
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TelegramGrant {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String    @default("PENDING") // PENDING | ADDED | REMOVED | PENDING_REMOVE
  note      String?
  /** ลิงก์เชิญส่วนตัวของสมาชิกรายนี้ (ใช้ได้ครั้งเดียว ผูกกับคิวใบนี้) */
  inviteLink String?
  /** Telegram user id ที่เข้ากลุ่มด้วยลิงก์นี้ — ใช้ตอนนำออก */
  telegramUserId String?
  invitedAt DateTime?
  addedAt   DateTime?
  removedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

model SlipOrder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode   String
  amountTHB  Int
  status     String    @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  slipData   String?   // base64 data URL ของสลิป (อย่า select ในหน้า list — แถวละหลาย MB)
  slipMime   String?
  // sha256 ของไฟล์สลิป — unique เพื่อกันส่งรูปเดิมซ้ำหลายออเดอร์
  slipHash   String?   @unique
  // เลขอ้างอิงรายการโอนจากผู้ให้บริการตรวจสลิป — กันสลิปซ้ำแม้ถ่ายรูปใหม่
  transRef   String?   @unique
  // ผลตรวจอัตโนมัติ: VERIFIED | MISMATCH | DUPLICATE | FAILED | SKIPPED
  verifyStatus String?
  verifyNote   String?
  verifiedAt   DateTime?
  note       String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String    @default("landing")
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
  /** โทเคนสำหรับลิงก์ยกเลิกในอีเมล — ไม่ต้องล็อกอินก็กดยกเลิกได้ */
  unsubscribeToken String? @unique

  @@index([createdAt])
}

/**
 * ตั๋วรีเซ็ตรหัสผ่าน — เก็บเฉพาะ sha256 ของโทเคน
 * ถ้าฐานข้อมูลหลุด คนที่ได้ไปก็ใช้รีเซ็ตรหัสผ่านใครไม่ได้
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
