// PostgreSQL ทั้ง dev และ production เพื่อให้พฤติกรรมตรงกัน
// dev รันด้วย docker (ดู docs/SETUP.md) — production ใช้ Neon/Supabase/Vercel Postgres
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // ใช้ผ่าน connection pooler — serverless เปิด connection เยอะ ถ้าต่อตรงจะเต็ม limit
  url       = env("DATABASE_URL")
  // ต่อตรงไม่ผ่าน pooler สำหรับ migrate/introspect (pooler ไม่รองรับ)
  // ถ้า provider ไม่มี pooler แยก ใส่ค่าเดียวกับ DATABASE_URL ได้
  directUrl = env("DIRECT_URL")
}

// ---------- Auth.js ----------
model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  /**
   * ชื่อผู้ใช้สำหรับล็อกอินแทนอีเมล — เก็บเป็นตัวพิมพ์เล็กเสมอเพื่อให้ค้นเจอ
   * ไม่ว่าผู้ใช้จะพิมพ์มาแบบไหน (unique ของ Postgres แยกตัวพิมพ์ใหญ่เล็ก)
   */
  username            String?   @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                String    @default("USER")
  tradingViewUsername String?
  /**
   * ทวงให้กรอก TradingView username ไปแล้วกี่ครั้ง และครั้งล่าสุดเมื่อไหร่
   * ไม่กรอก = จ่ายเงินแล้วแต่ไม่ได้ของ และเป็นขั้นตอนเดียวที่ทำแทนลูกค้าไม่ได้
   * เก็บไว้เพื่อเว้นจังหวะการทวง ไม่ให้กลายเป็นสแปม
   */
  tvRemindedAt        DateTime?
  tvRemindCount       Int       @default(0)
  /**
   * ราคารายเดือนที่ล็อกไว้ให้สมาชิกโปรโมชัน 300 คนแรก
   * ใช้ได้ตราบที่ยังไม่ขาดอายุ — เงื่อนไขจริงอยู่ที่ isPriceLockValid() ใน lib/pricing.ts
   * ไม่ลบค่านี้ทิ้งตอนขาดอายุ เพื่อให้ยังตรวจย้อนได้ว่าใครเคยได้ราคาล็อก
   */
  lockedMonthlyTHB    Int?
  discordUserId       String?   @unique
  discordUsername     String?
  // รู้ได้ตอนสมาชิกกดเข้ากลุ่มผ่านลิงก์ส่วนตัว — ใช้ตอนนำออกเมื่อหมดอายุ
  telegramUserId      String?   @unique
  telegramUsername    String?
  lineUserId          String?
  stripeCustomerId    String?   @unique
  /**
   * บัญชีเทรดที่ผูกกับสมาชิกคนนี้ รูปแบบ "<โบรก>:<เลขบัญชี>" เช่น "wisdom:12345678"
   * ผูกตอนแอดมินอนุมัติเท่านั้น ไม่ใช่ตอนส่งคำขอ — ถ้าผูกตอนส่ง ใครพิมพ์เลขบัญชีของคนอื่น
   * ก่อนก็จองไว้ได้ แล้วเจ้าของตัวจริงจะส่งคำขอไม่ได้
   * unique กันบัญชีเดียวถูกใช้รับสิทธิ์ฟรีให้หลายคน
   */
  brokerAccountKey    String?   @unique
  createdAt           DateTime  @default(now())

  accounts           Account[]
  sessions           Session[]
  subscriptions      Subscription[]
  accessGrants       AccessGrant[]
  payments           Payment[]
  telegramGrants     TelegramGrant[]
  slipOrders         SlipOrder[]
  reviews            Review[]
  passwordResets     PasswordResetToken[]
  brokerApplications BrokerApplication[]
  brokerEventsLogged BrokerEvent[]
  aiConversations    AiConversation[]
  aiUsage            AiUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Business ----------
model Plan {
  id            String  @id @default(cuid())
  code          String  @unique
  name          String
  priceTHB      Int
  interval      String
  stripePriceId String?
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  subscriptions Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * ⚠️ planId / plan relation ไม่มีโค้ดไหน join ผ่านเลยสักที่ (ตรวจแล้ว 2026-08-29)
   * ตัวที่ใช้งานจริงคือ planCode ซึ่งเทียบกับ src/config/plans.ts ไม่ใช่ตาราง Plan
   * ตาราง Plan เหลือหน้าที่เดียวคือผูก Stripe Price ID และให้หน้าแอดมินเตือน
   * เวลาราคาใน DB กับใน config ไม่ตรงกัน — อย่าเพิ่งลบทิ้งจนกว่าจะเลิกใช้ Stripe
   */
  planId               String?
  plan                 Plan?     @relation(fields: [planId], references: [id])
  planCode             String
  stripeSubscriptionId String?   @unique
  stripeCustomerId     String?
  status               String    @default("INACTIVE")
  currentPeriodEnd     DateTime?
  /**
   * เตือนใกล้หมดอายุไปแล้วที่หลักกี่วัน — เก็บหลักที่เล็กที่สุดที่ส่งไปแล้ว
   *
   * ของเดิมใช้ expiryNotifiedAt เป็นธงว่า "เตือนแล้ว" ซึ่งเตือนได้ครั้งเดียวต่อรอบบิล
   * พอจะเตือนหลายหลัก (7/3/1) ต้องรู้ว่าหลักไหนส่งไปแล้ว ไม่งั้นจะส่งซ้ำทุกวัน
   * null = ยังไม่เคยเตือนรอบนี้ · 7 = เตือนหลัก 7 วันแล้ว เหลือ 3 กับ 1
   */
  expiryNotifiedDays   Int?
  cancelAtPeriodEnd    Boolean   @default(false)
  // เวลาที่ cron ปิดสิทธิ์จริง (ไม่ใช่แค่วันครบกำหนด) ใช้ตรวจย้อนหลังว่าปิดไปแล้วจริง
  expiredAt            DateTime?
  // กันส่งอีเมลเตือนใกล้หมดอายุซ้ำในรอบเดียวกัน — เคลียร์เป็น null ทุกครั้งที่ต่ออายุ
  expiryNotifiedAt     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accessGrants AccessGrant[]

  // cron รายวันกวาดด้วยสองคอลัมน์นี้เป็นหลัก
  @@index([status, currentPeriodEnd])
  @@index([userId])
}

model AccessGrant {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId      String?
  subscription        Subscription? @relation(fields: [subscriptionId], references: [id])
  status              String        @default("PENDING")
  tradingViewUsername String?
  note                String?
  grantedAt           DateTime?
  revokedAt           DateTime?
  createdAt           DateTime      @default(now())
  /**
   * สั่งบอทไปครั้งล่าสุดเมื่อไหร่ (null = ยังไม่เคยสั่ง)
   * ใช้เว้นจังหวะการสั่งซ้ำ — ถ้านับจาก createdAt อย่างเดียว งานที่รออยู่ในคิวบอท
   * จะถูกสั่งซ้ำทุกรอบ reconcile เพราะ createdAt ไม่ขยับ
   */
  lastDispatchedAt    DateTime?
  /**
   * บอททำให้ไม่สำเร็จติดกันกี่ครั้ง และเหตุผลล่าสุดคืออะไร
   * ใช้หยุดวนซ้ำงานที่ลองอีกกี่ครั้งก็ไม่สำเร็จ (เช่น username ไม่มีอยู่จริงบน TradingView)
   * และใช้กันไม่ให้เตือนแอดมินซ้ำด้วยเหตุผลเดิมทุกรอบ
   */
  failCount           Int           @default(0)
  lastFailReason      String?

  // คิวแอดมินและ callback ของ TradingView กรองด้วยสองคอลัมน์นี้เป็นหลัก
  @@index([status])
  @@index([userId])
}

model Payment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountTHB   Int
  provider    String   @default("stripe")
  /**
   * เลขอ้างอิงจากช่องทางที่ได้เงิน — unique เพื่อกันบันทึกเงินก้อนเดียวซ้ำ
   * เดิมกันซ้ำด้วยการ findFirst แล้วค่อย create ซึ่ง race ได้เต็ม ๆ
   * (webhook ของ Stripe ยิงซ้ำเป็นเรื่องปกติเวลา timeout)
   * NULL ซ้ำกันได้ตามพฤติกรรม unique index ของ Postgres ซึ่งถูกต้องแล้ว
   */
  providerRef String?  @unique
  status      String
  createdAt   DateTime @default(now())

  // countPaidMembers() ยิงทุกครั้งที่เรนเดอร์หน้าแรก และกรองด้วย status
  @@index([status])
  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String?
  userName   String
  rating     Int
  comment    String
  plan       String?
  isApproved Boolean  @default(false)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Signal {
  id        String   @id @default(cuid())
  timeframe String
  side      String?
  symbol    String?
  entry     String?
  tp        String?
  /**
   * อินดิเคเตอร์ส่ง TP มาสองชั้น (TP1/TP2) — tp คือ TP1
   */
  tp2       String?
  sl        String?
  note      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model TelegramGrant {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("PENDING") // PENDING | ADDED | REMOVED | PENDING_REMOVE
  note           String?
  /**
   * ลิงก์เชิญส่วนตัวของสมาชิกรายนี้ (ใช้ได้ครั้งเดียว ผูกกับคิวใบนี้)
   */
  inviteLink     String?
  /**
   * Telegram user id ที่เข้ากลุ่มด้วยลิงก์นี้ — ใช้ตอนนำออก
   */
  telegramUserId String?
  invitedAt      DateTime?
  /**
   * ส่งลิงก์ให้สมาชิกทางอีเมลไปแล้วเมื่อไหร่
   * รอบกวาดรายวันใช้ช่องนี้ตัดสินว่าใครยังไม่ได้ลิงก์ ถ้าไม่มีจะยิงอีเมลซ้ำทุกวัน
   */
  notifiedAt     DateTime?
  /**
   * ลิงก์ใบนี้ออกให้กลุ่มไหน (ค่า TELEGRAM_CHAT_ID ตอนที่ออกลิงก์)
   *
   * ลิงก์เชิญผูกกับกลุ่มเดิมตลอดไป ย้ายกลุ่มเมื่อไหร่ลิงก์เก่าจะพาลูกค้าไปผิดห้อง
   * เก็บไว้เพื่อให้ระบบรู้เองว่าใบไหนของกลุ่มเก่า แล้วออกใหม่ให้อัตโนมัติ
   * (29 ก.ย. 69 ย้ายจาก TD_SMC ไป QVX SIGNAL แล้วลิงก์เก่ายังพาไปห้องเดิม)
   */
  chatId         String?
  addedAt        DateTime?
  removedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

model SlipOrder {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode     String
  amountTHB    Int
  status       String    @default("PENDING") // PENDING | SUBMITTED | APPROVED | REJECTED
  slipData     String? // base64 data URL ของสลิป (อย่า select ในหน้า list — แถวละหลาย MB)
  slipMime     String?
  // sha256 ของไฟล์สลิป — unique เพื่อกันส่งรูปเดิมซ้ำหลายออเดอร์
  slipHash     String?   @unique
  // เลขอ้างอิงรายการโอนจากผู้ให้บริการตรวจสลิป — กันสลิปซ้ำแม้ถ่ายรูปใหม่
  transRef     String?   @unique
  // ผลตรวจอัตโนมัติ: VERIFIED | MISMATCH | DUPLICATE | FAILED | SKIPPED
  verifyStatus String?
  verifyNote   String?
  verifiedAt   DateTime?
  note         String?
  reviewedAt   DateTime?
  /**
   * คืนเงินแล้วเมื่อไหร่ — แยกจาก status ตั้งใจ
   *
   * REJECTED แปลว่า "สลิปไม่ผ่านการตรวจ" ซึ่งลูกค้าเห็นข้อความว่าให้ติดต่อทีมงาน
   * ใช้แทน "คืนเงินแล้ว" ไม่ได้ เพราะคนละเรื่องและทำให้ลูกค้าเข้าใจผิด
   * อีกอย่างคืนเงินเกิดได้ทั้งตอน SUBMITTED และ APPROVED จึงต้องเป็นคนละแกนกับ status
   *
   * ไม่มีช่องนี้มาก่อน = คนที่คืนเงินไปแล้วยังค้างอยู่ในรายการรอดำเนินการตลอดไป
   * แล้วรอบหน้าจะโอนคืนซ้ำ
   */
  refundedAt   DateTime?
  /** ยอดที่คืนจริง อาจไม่เท่ายอดเต็มถ้าหักค่าธรรมเนียมโอน */
  refundTHB    Int?
  refundNote   String?
  refundedById String?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  source           String    @default("landing")
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
  /**
   * โทเคนสำหรับลิงก์ยกเลิกในอีเมล — ไม่ต้องล็อกอินก็กดยกเลิกได้
   */
  unsubscribeToken String?   @unique

  @@index([createdAt])
}

/**
 * ตั๋วรีเซ็ตรหัสผ่าน — เก็บเฉพาะ sha256 ของโทเคน
 * ถ้าฐานข้อมูลหลุด คนที่ได้ไปก็ใช้รีเซ็ตรหัสผ่านใครไม่ได้
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// ตัวนับสำหรับจำกัดจำนวนครั้ง (rate limit) — เก็บใน DB เพราะ serverless
/// แต่ละ request อาจอยู่คนละ instance ตัวนับในหน่วยความจำจึงใช้ร่วมกันไม่ได้
/// key = ประเภท+ค่าที่จำกัด เช่น "login:id:somchai" หรือ "login:ip:1.2.3.4"
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * คำขอรับสิทธิ์ผ่านโบรก — ทางที่ 2 ของการได้อินดิเคเตอร์ (ทางที่ 1 คือจ่ายเงิน)
 * ลูกค้าเปิดพอร์ตกับโบรกผ่านลิงก์ของ QVX แล้วส่งเลขบัญชีมา แอดมินเข้าไปตรวจในระบบโบรกเอง
 * อนุมัติแล้วเรียก activateMembership ตัวเดียวกับทางจ่ายเงิน (ยอด 0 บาท ช่องทาง wisdom)
 * จากนั้นบอท TradingView · Telegram · Discord · การหมดอายุ ทำงานเหมือนสมาชิกจ่ายเงินทุกอย่าง
 * เก็บทุกคำขอเป็นแถวใหม่ รวมคำขอต่ออายุ — ย้อนดูได้ว่าใครขอเมื่อไหร่ ใครอนุมัติ ปฏิเสธเพราะอะไร
 */
model BrokerApplication {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker              String    @default("wisdom")
  tradingAccount      String
  /**
   * TradingView username ณ ตอนส่งคำขอ — เก็บไว้ให้แอดมินเทียบ ตัวที่บอทใช้จริงอ่านจาก User
   */
  tradingViewUsername String
  /**
   * อีเมลที่ใช้เปิดบัญชีกับโบรก — อาจไม่ใช่อีเมลที่สมัคร QVX
   * แอดมินใช้ตัวนี้ตามหาบัญชีในระบบโบรก ซึ่งค้นด้วยเลขบัญชีอย่างเดียวบางทีไม่เจอ
   * ไม่บังคับ เพราะคำขอเก่าที่ส่งมาก่อนมีฟิลด์นี้จะเป็น null
   */
  brokerEmail         String?
  /**
   * ค่าอยู่ใน BROKER_APPLICATION_STATUS (src/config/status.ts)
   */
  status              String    @default("PENDING")
  /**
   * ส่งตอนยังมีสิทธิ์อยู่ = ขอต่ออายุ
   */
  isRenewal           Boolean   @default(false)
  /**
   * ค่าอยู่ใน BROKER_REJECTION_REASONS (src/config/brokers.ts)
   */
  rejectionReason     String?
  /**
   * ข้อความถึงลูกค้า — บังคับเมื่อเหตุผลคือ OTHER เพราะไม่งั้นลูกค้าไม่รู้ว่าต้องแก้อะไร
   */
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([broker, tradingAccount])
}

/// ---------- QVX AI ----------
/// ย้ายมาจาก Supabase ของน็อต — สิทธิ์ใช้ AI ไม่มีตารางของตัวเองแล้ว
/// ตัดสินจากสมาชิกภาพจริงทุกครั้ง (getUserSubscription) สิทธิ์อินดิเคเตอร์หมด AI ก็หมดพร้อมกัน

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("แชตใหม่")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /**
   * "user" | "assistant"
   */
  role           String
  content        String
  model          String?
  /**
   * หัวข้อความรู้ (RAG) ที่คำตอบนี้อ้างอิง — โชว์เป็นชิปใต้คำตอบ รวมถึงตอนเปิดประวัติแชต
   */
  sources        String[]       @default([])
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

/// หนึ่งแถว = หนึ่งคำถาม · โควตานับจากตารางนี้ (PENDING ที่ยังไม่เก่า + SUCCESS ในเดือนนี้)
/// จองแถว PENDING ก่อนเรียกโมเดล — ยิงพร้อมกันหลายคำขอจะไม่หลุดเกินโควตา
model AiUsage {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  /**
   * ค่าอยู่ใน AI_USAGE_STATUS (src/config/ai.ts)
   */
  status         String   @default("PENDING")
  model          String?
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  latencyMs      Int?
  errorCode      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, createdAt])
}

/// ข้อมูลตลาดล่าสุดที่อินดิเคเตอร์ QVX AI บน TradingView ส่งมา — หนึ่งแถวต่อสินทรัพย์ เขียนทับทุกครั้ง
model MarketSnapshot {
  tickerId     String   @id
  symbol       String
  exchange     String?
  chartTf      String
  barTime      DateTime
  barCloseTime DateTime
  /**
   * false = แท่งยังไม่ปิด มุมมองยังเปลี่ยนได้
   */
  confirmed    Boolean
  qvx          Json
  timeframes   Json
  receivedAt   DateTime @default(now())

  @@index([receivedAt])
}

/// URL ของบริดจ์ TradingView ที่บอทรายงานเข้ามาเอง (POST /api/tradingview/register)
/// Cloudflare quick tunnel ได้ URL ใหม่ทุกรีสตาร์ต — ให้บอทบอกเว็บเองแทนการฝาก Vercel token ไว้ที่เครื่องบ้าน
/// เว็บใช้ค่านี้ก่อน env (TV_BOT_URL / TV_BOT_URL_BACKUP) เมื่อรายงานเข้ามาไม่เกิน 15 นาที
model BridgeEndpoint {
  /**
   * "primary" | "backup"
   */
  role       String   @id
  url        String
  /**
   * botkeeper รายงานเข้ามา = "เครื่องยังเปิดและ keeper ยังเดิน"
   * ไม่ได้แปลว่าตัวบริดจ์ยังเดิน — ดู unreachableSince ประกอบเสมอ
   */
  lastSeenAt DateTime
  /**
   * /health ตอบไม่ได้ต่อเนื่องมาตั้งแต่เมื่อไหร่ (null = ตอบได้ครั้งล่าสุด)
   * มีไว้แยก "เงียบเพราะกำลังทำงาน" ออกจาก "ตายแล้วแต่ keeper ยังอยู่"
   */
  unreachableSince DateTime?
  updatedAt  DateTime @updatedAt
}

/// "งานนี้รันล่าสุดเมื่อไหร่" — ใช้จับงานที่หยุดไปเงียบ ๆ
///
/// ทำไมต้องมี: ระบบแจ้งเตือนที่เตือนแค่ "ตอนพัง" มีรูใหญ่อยู่ — ถ้างานไม่ได้รันเลย
/// (เครื่องปิด, งานตั้งเวลาถูกปิด, สคริปต์หาย) จะไม่มีใครส่งอะไรมา ความเงียบจึง
/// ดูเหมือนว่าทุกอย่างปกติ ซึ่งเป็นตอนที่อันตรายที่สุด
/// เก็บเวลาที่รันสำเร็จล่าสุดไว้ แล้วให้ cron รายวันเป็นคนทักว่า "เงียบไปนานแล้วนะ"
model SystemHeartbeat {
  /// ชื่องาน เช่น "db-backup"
  name       String   @id
  lastSeenAt DateTime
  /// ข้อความสรุปผลรอบล่าสุด (ขนาดไฟล์ จำนวนตาราง ฯลฯ) ให้แอดมินดูได้ว่าปกติไหม
  detail     String?
  updatedAt  DateTime @updatedAt
}

/// เหตุการณ์จากโบรก (สมัคร / ฝาก / ถอน) — ใช้เป็นหลักฐานประกอบการอนุมัติคำขอรับสิทธิ์
/// Wisdom ไม่มี API จึงรับจากอีเมลแจ้งเตือนที่พาร์ตเนอร์ส่งต่อมา หรือพาร์ตเนอร์บันทึกเอง
model BrokerEvent {
  id             String   @id @default(cuid())
  broker         String   @default("wisdom")
  /// ค่าอยู่ใน BROKER_EVENT_TYPE (src/config/status.ts)
  type           String
  /// เลขบัญชีเทรด — ตัวเชื่อมกับ BrokerApplication.tradingAccount (อ่านจากอีเมลไม่เจอก็เป็น null ได้)
  tradingAccount String?
  accountName    String?
  accountEmail   String?
  amountUSD      Float?
  /// เวลาที่เหตุการณ์เกิดตามอีเมล (ไม่ใช่เวลาที่เรารับเข้า)
  occurredAt     DateTime
  /// "email" | "manual"
  source         String
  /// Message-ID ของอีเมล — กันบันทึกซ้ำเมื่อบอทอ่านอีเมลเดิมรอบสอง
  externalId     String?  @unique
  /// อีเมลดิบ (ตัดความยาวแล้ว) — ไว้ให้คนดูตอนตัวอ่านแยกไม่ออก และไว้ตรวจย้อนหลัง
  rawText        String?
  /// พาร์ตเนอร์/แอดมินที่บันทึกเอง (source = manual)
  loggedById     String?
  loggedBy       User?    @relation(fields: [loggedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([tradingAccount, occurredAt])
  @@index([type, occurredAt])
}
