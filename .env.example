# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LINE_OA_URL=https://line.me/R/ti/p/@yourlineoa
NEXT_PUBLIC_LINE_OA_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
# อีเมลที่จะถูกเลื่อนเป็น ADMIN ตอนรัน seed (คั่นด้วย comma)
ADMIN_EMAILS=

# ---- ข้อมูลผู้ประกอบการ (แสดงในหน้ากฎหมาย) ----
# ไม่กรอก = หน้ากฎหมายไม่แสดงชื่อผู้ขาย ซึ่งลดความน่าเชื่อถือและเสี่ยงเรื่อง
# การเปิดเผยตัวตนผู้ขายตามกฎหมายคุ้มครองผู้บริโภค
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=

# ---- Database (PostgreSQL) ----
# dev: รัน docker ตาม docs/SETUP.md แล้วใช้ค่านี้ได้เลย
#   postgresql://tradepulse:devpass@localhost:5433/tradepulse?schema=public
# production (Neon/Supabase/Vercel Postgres):
#   DATABASE_URL = connection string แบบ pooled (มักมี -pooler หรือ pgbouncer=true)
#   DIRECT_URL   = connection string แบบต่อตรง ใช้ตอน migrate เท่านั้น
# ถ้าผู้ให้บริการไม่มี pooler แยก ใส่ค่าเดียวกันทั้งสองตัวได้
DATABASE_URL=
DIRECT_URL=

# ---- Auth.js ----
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=

# ---- ชำระเงิน: โหมด ----
# "qr" = PromptPay + แนบสลิป (ค่าเริ่มต้น ไม่มีค่าธรรมเนียม)
# "stripe" = Stripe Checkout แบบตัดเงินอัตโนมัติ
NEXT_PUBLIC_PAYMENT_MODE="qr"

# ---- ชำระเงิน: PromptPay QR ----
PROMPTPAY_ID=
PROMPTPAY_NAME=

# ---- ตรวจสลิปอัตโนมัติ (ไม่บังคับ — ดู docs/SLIP.md) ----
# ไม่ตั้ง = แอดมินตรวจสลิปเองเหมือนเดิม
EASYSLIP_TOKEN=
# "true" = ยอดตรงแล้วเปิดสิทธิ์ให้ทันทีโดยไม่ต้องรอแอดมิน
SLIP_AUTO_APPROVE="false"

# ---- ชำระเงิน: Stripe (ใช้เมื่อ NEXT_PUBLIC_PAYMENT_MODE=stripe) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_Q3=
STRIPE_PRICE_H6=
STRIPE_PRICE_YEAR=

# ---- อีเมล (Resend — ดู docs/EMAIL.md) ----
# ไม่ตั้ง = ระบบทำงานปกติทุกอย่าง แค่ไม่ส่งอีเมล (และรีเซ็ตรหัสผ่านเองไม่ได้)
RESEND_API_KEY=
EMAIL_FROM="TradePulse <no-reply@yourdomain.com>"
EMAIL_REPLY_TO=

# ---- งานประจำวัน (ปิดสิทธิ์สมาชิกหมดอายุ — ดู docs/LIFECYCLE.md) ----
# ต้องตั้ง ไม่งั้น /api/cron/expire จะถูกปิดตายและไม่มีอะไรมาปิดสิทธิ์เลย
CRON_SECRET=

# ---- Telegram (สัญญาณ + แจ้งเตือนแอดมิน — ดู docs/TELEGRAM.md) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_M5=
TELEGRAM_TOPIC_M15=
TELEGRAM_TOPIC_M30=
TELEGRAM_TOPIC_1H=
TELEGRAM_SIGNAL_SECRET=
# รหัสยืนยันของ webhook (ตั้งเอง สุ่มยาว ๆ) — ต้องมีถึงจะเชิญเข้ากลุ่มอัตโนมัติได้
# ตั้งค่าแล้วรัน: node scripts/telegram-webhook.mjs set
TELEGRAM_WEBHOOK_SECRET=
# ลิงก์กลุ่มแบบเดิม (ใช้เป็นทางสำรองเมื่อยังไม่เปิดระบบเชิญอัตโนมัติ)
TELEGRAM_INVITE_URL=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_TOPIC_ID=

# ---- Discord (ให้ยศอัตโนมัติ — ดู docs/DISCORD.md) ----
NEXT_PUBLIC_DISCORD_INVITE_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_MEMBER=
DISCORD_ROLE_MONTH=
DISCORD_ROLE_Q3=
DISCORD_ROLE_H6=
DISCORD_ROLE_YEAR=

# ---- บอทให้สิทธิ์ TradingView อัตโนมัติ (ไม่บังคับ — ดู docs/TRADINGVIEW.md) ----
# ไม่ตั้ง = แอดมินเพิ่ม username ในสคริปต์เองผ่านคิว /admin/access-queue
# บอทอยู่ repo แยก (electiction/Bot-Tradingview -> tv_bridge.py)
TV_BOT_URL=
# ใช้ทั้งตอนเรียกบอท และตอนบอทยิงผลกลับมาที่ /api/tradingview/callback
TV_BOT_SECRET=

# ---- TradingView chart บนหน้าเว็บ ----
# ลิงก์ layout กราฟจริงที่ติดตั้งอินดิเคเตอร์ TradePulse ไว้แล้ว
NEXT_PUBLIC_TRADINGVIEW_CHART_URL=https://th.tradingview.com/chart/AOJ68CcI/?symbol=FOREXCOM%3AXAUUSD
NEXT_PUBLIC_TRADINGVIEW_SYMBOL=FOREXCOM:XAUUSD
NEXT_PUBLIC_TRADINGVIEW_INTERVAL=30
# ภาพ snapshot กราฟจริง (กดปุ่มกล้อง 📷 บน TradingView -> คัดลอกลิงก์ภาพ)
# ปล่อยว่างได้ = ใช้ค่า default ใน src/config/site.ts
# ถ้าเปลี่ยนภาพ อย่าลืมแก้ ASPECT ให้ตรงกับขนาดภาพใหม่ (กว้าง / สูง)
NEXT_PUBLIC_TRADINGVIEW_SNAPSHOT_URL=
NEXT_PUBLIC_TRADINGVIEW_SNAPSHOT_ASPECT=
NEXT_PUBLIC_TRADINGVIEW_SNAPSHOT_PAGE_URL=

# ---- ชุมชน Telegram (ลิงก์สาธารณะบนหน้าแรก) ----
NEXT_PUBLIC_TELEGRAM_COMMUNITY_URL=
