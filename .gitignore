# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# โฟลเดอร์ build cache ที่ถูกเปลี่ยนชื่อไว้ — ถ้าไม่ ignore Tailwind v4 จะสแกน
# แล้วดูด class เพี้ยนจาก CSS/source-map เก่ามาสร้าง selector พังทั้งไฟล์
/.next-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite dev database (contains test data)
/prisma/dev.db
/prisma/dev.db-journal
*.db-journal

# keep env template committed (was excluded by .env*)
!.env.example

# ---- Pine Script source ของสินค้า (ห้าม commit เด็ดขาด) ----
# เป็นซอร์สอินดิเคเตอร์ที่ขายอยู่ ถ้าเข้า git แล้วลบยาก และหลุดได้ถ้า repo เปลี่ยนเป็น public
/SMC Unified.txt
/SMC suit strategy.txt
/Change SL.txt
/*.pine
/pine/
/.pine-backup/

# build logs
*.log
